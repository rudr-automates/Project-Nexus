########################################
# Project Nexus
# Environment Template
########################################

# -------------------------
# Project
# -------------------------

PROJECT_NAME=project-nexus
PROJECT_VERSION=1.0

# -------------------------
# Docker
# -------------------------

COMPOSE_PROJECT_NAME=project-nexus

# -------------------------
# PostgreSQL
# -------------------------

POSTGRES_DB=project_nexus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_PORT=5432

# -------------------------
# n8n
# -------------------------

N8N_PORT=5678
N8N_PROTOCOL=https
N8N_HOST=n8n.example.com
WEBHOOK_URL=https://n8n.example.com
N8N_ENCRYPTION_KEY=replace_with_secure_key

# -------------------------
# Timezone
# -------------------------

GENERIC_TIMEZONE=Asia/Kolkata

# -------------------------
# Cloudflare
# -------------------------

CLOUDFLARE_TUNNEL_TOKEN=your_token_here

# -------------------------
# Browserless
# -------------------------

BROWSERLESS_TOKEN=replace_with_secure_token

BROWSERLESS_CONCURRENT=3

BROWSERLESS_TIMEOUT=300000

# -------------------------
# Logging
# -------------------------

LOG_LEVEL=info

########################################
# Browser Runtime
########################################

BROWSERLESS_ENDPOINT=ws://browserless:3000

BROWSERLESS_TOKEN=project-nexus-browserless

BROWSER_TIMEOUT=30000

BROWSER_HEADLESS=true

BROWSER_MAX_CONCURRENCY=3